# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/ikhlas.db
NODE_ENV=development
TRUST_PROXY=false
# Opsional. Default: true untuk database lokal, false bila memakai Turso/Vercel.
SEED_DEMO_DATA=

# Turso (libSQL) untuk produksi/Vercel. Jika TURSO_DATABASE_URL diisi,
# DATABASE_PATH diabaikan. Kosongkan untuk memakai berkas SQLite lokal.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron: endpoint /api/cron/daily-backup hanya menerima
# "Authorization: Bearer <CRON_SECRET>". Isi string acak minimal 16 karakter.
CRON_SECRET=

# Google Drive attachment storage
# OAuth 2.0 Client type: Web application
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Opsional. Jika kosong, IKHLAS membuat folder "IKHLAS - Bukti Transaksi"
# di My Drive akun OAuth secara otomatis.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=IKHLAS - Bukti Transaksi
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Auto backup database ke Google Drive (snapshot JSON)
# Server lokal/VPS: scheduler internal memakai jam di bawah.
# Vercel: dipicu Vercel Cron pukul 19:00 UTC (02:00 WIB), lihat vercel.json.
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_FOLDER_NAME=IKHLAS - Backup Database
GOOGLE_DRIVE_BACKUP_HOUR=2
GOOGLE_DRIVE_BACKUP_MINUTE=0
GOOGLE_DRIVE_BACKUP_TIMEZONE=Asia/Jakarta
GOOGLE_DRIVE_BACKUP_RETENTION=30

# Notifikasi push PWA (opsional). Buat kunci dengan:
#   npx web-push generate-vapid-keys
# Tanpa kunci, aplikasi tetap berjalan; badge jumlah pengajuan tetap tampil di aplikasi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.id

# Web
# Kosongkan di Vercel: build produksi otomatis memakai /api pada domain yang sama.
VITE_API_URL=http://localhost:3001/api
